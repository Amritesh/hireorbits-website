---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { services, models } from '../data/company';
import { url } from '../lib/url';
const sap = services.find((service) => service.id === 'sap')!;
const modules = [
  ['FICO', 'Finance & controlling'],
  ['MM', 'Materials management'],
  ['SD', 'Sales & distribution'],
  ['PP', 'Production planning'],
  ['HCM', 'Human capital management'],
  ['ABAP', 'Development & application support'],
];
---

<Layout
  title="SAP consulting & enterprise solutions"
  description="SAP consulting, implementation support, S/4HANA, ABAP, and module-specific SAP staffing for FICO, MM, SD, PP, HCM, and more from Hireorbits."
>
  <PageHeading
    eyebrow="SAP CONSULTING & ENTERPRISE SOLUTIONS"
    title="The right SAP expertise for every stage of your project."
    description="From implementation and S/4HANA moves to long-term support, find the SAP consultants and functional and technical talent your project requires."
  />
  <section class="section">
    <div class="container">
      <div class="section-top">
        <div>
          <p class="eyebrow">WHAT WE OFFER</p>
          <h2>SAP services and talent, together.</h2>
        </div>
        <p>{sap.description}</p>
      </div>
      <ul class="check-list">
        {sap.items.map((item) => (
          <li>
            <Icon name="check" size={18} />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section tint-section">
    <div class="container">
      <p class="eyebrow">MODULE-SPECIFIC STAFFING</p>
      <h2>Specialists across SAP modules.</h2>
      <p>We match functional and technical SAP talent to your project requirements.</p>
      <div class="model-grid">
        {modules.map(([code, name]) => (
          <div>
            <span class="model-number">SAP</span>
            <h3>{code}</h3>
            <p>{name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">FLEXIBLE ENGAGEMENT</p>
      <h2>Onsite, offshore, hybrid, or remote.</h2>
      <div class="model-grid">
        {models.map((model, index) => (
          <div>
            <span class="model-number">0{index + 1}</span>
            <h3>{model.title}</h3>
            <p>{model.description}</p>
          </div>
        ))}
      </div>
      <p>
        <a class="text-link" href={url('services/#sap')}>
          See all our services <Icon size={18} />
        </a>
      </p>
    </div>
  </section>
  <CTA />
</Layout>
